# --- Required ---
# PostgreSQL connection string. With docker-compose this is built for you from POSTGRES_* below.
DATABASE_URL=postgres://lingualoop:change-me-db-password@localhost:5432/lingualoop
# Long random string (at least 16 chars) used to sign session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# --- Admin account (created on start if missing; existing user is promoted to admin) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
# Set to true for one deploy to overwrite the admin's password with ADMIN_PASSWORD.
# ADMIN_RESET_PASSWORD=false

# --- Server ---
PORT=3000

# --- Optional ---
# Use TLS to the database (managed Postgres usually needs this): true | require
# DATABASE_SSL=true
# Cookies are Secure in production. Set to false ONLY when testing over plain http://.
# COOKIE_SECURE=false
# PG_POOL_MAX=10

# --- docker-compose only (database container) ---
POSTGRES_USER=lingualoop
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=lingualoop
